{
  "name": "liquid-gooey",
  "version": "0.1.0",
  "description": "Liquid UI effects for React: Morph (gooey merge, jelly shape change, contact dissolve) and Move (liquid-rubber trails). SVG-filter silhouette layer + crisp content layer, real shadows on the merged liquid. Cross-browser, Safari included.",
  "license": "MIT",
  "type": "module",
  "sideEffects": false,
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.cjs"
    }
  },
  "files": [
    "dist"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Jakubantalik/Libraries.git",
    "directory": "packages/liquid-gooey"
  },
  "bugs": {
    "url": "https://github.com/Jakubantalik/Libraries/issues"
  },
  "homepage": "https://gooey.jakubantalik.com",
  "scripts": {
    "build": "tsup src/index.ts --format esm,cjs --dts --sourcemap --clean",
    "typecheck": "tsc --noEmit"
  },
  "peerDependencies": {
    "react": ">=18",
    "react-dom": ">=18"
  },
  "devDependencies": {
    "@types/react": "^18.3.3",
    "@types/react-dom": "^18.3.0",
    "tsup": "^8.1.0",
    "typescript": "^5.5.3"
  },
  "keywords": [
    "react",
    "gooey",
    "metaball",
    "liquid",
    "svg-filter",
    "animation",
    "spring"
  ]
}
