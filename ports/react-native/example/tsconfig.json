{
  "extends": "expo/tsconfig.base",
  "compilerOptions": {
    "strict": true,
    "baseUrl": ".",
    // mirrors metro.config.js's extraNodeModules — Metro resolves the sibling
    // package from source, and TypeScript has to be told the same thing
    "paths": {
      "thinking-orbs-native": ["../thinking-orbs-native/src"]
    }
  },
  "include": ["**/*.ts", "**/*.tsx"]
}
